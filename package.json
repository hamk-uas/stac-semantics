{
  "name": "stac-extension-semantics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npm run check-markdown && npm run check-examples && npm run check-schema",
    "check-markdown": "remark . -f -r .github/remark.yaml",
    "check-examples": "stac-node-validator . --lint --verbose --schemaMap https://hamk-uas.github.io/stac-semantics/v0.1.0/schema.json=./json-schema/schema.json",
    "check-schema": "node --test tests/schema.test.mjs",
    "format-examples": "stac-node-validator . --format --schemaMap https://hamk-uas.github.io/stac-semantics/v0.1.0/schema.json=./json-schema/schema.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "remark-cli": "^12.0.0",
    "remark-gfm": "^4.0.0",
    "remark-lint": "^10.0.0",
    "remark-lint-no-html": "^4.0.0",
    "remark-preset-lint-consistent": "^6.0.0",
    "remark-preset-lint-markdown-style-guide": "^6.0.0",
    "remark-preset-lint-recommended": "^7.0.0",
    "remark-validate-links": "^13.0.0",
    "stac-node-validator": "^1.3.0"
  }
}
